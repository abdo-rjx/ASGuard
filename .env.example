# ASGuard — AI Security Firewall
# All variables are dev defaults. Never commit real secrets.
# Copy to .env and adjust.

# --- Application --------------------------------------------------------
ASGUARD_ENVIRONMENT=development
ASGUARD_HOST=0.0.0.0
ASGUARD_PORT=8000
ASGUARD_LOG_LEVEL=INFO

# --- ASGuard's own metadata database (PostgreSQL) -----------------------
# This is ASGuard's metadata store (policies, events, applications, settings).
# It is NOT an enterprise database and never holds business data.
DATABASE_URL=postgresql+asyncpg://asguard:asguard_dev@localhost:5432/asguard

# --- Demo mode ----------------------------------------------------------
# When true, ASGuard seeds a "Demo Assistant" application pointing at the
# built-in mock OpenAI-compatible upstream so the full pipeline works
# without external API keys.
SEED_DEMO_DATA=true
DEMO_UPSTREAM_URL=http://localhost:8000/demo/upstream/v1

# --- Security defaults ---------------------------------------------------
# fail_closed = a crashing detector causes a BLOCK. Never weaken casually.
DETECTOR_FAILURE_MODE=fail_closed
DEFAULT_BLOCK_THRESHOLD=70

# Privacy by default: ASGuard never stores raw prompts/responses.
ALLOW_CONTENT_LOGGING=false